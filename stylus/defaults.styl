brand3 = rgba(0,133,187,1.0) // mid blue #0085bb
brand4 = rgba(0,193,159,1.0) // green #00c19f
brand5 = rgba(206,184,136,1.0) // tan #ceb888
brand6 = rgba(152,164,174,1.0) // silver #98a4ae
brand7 = rgba(131,136,186,1.0) // violet #8388ba

brand2Alp50 = color: rgba(215,246,255,1.0)


