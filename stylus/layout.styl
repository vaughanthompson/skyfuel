//core layout
@media ttrigger  
    body header
        display: flex
        justify-content: flex-start
        align-items: center
        flex-wrap: nowrap
        padding: 5px 0
        width:100%
        background-color: brand1
        z-index 2
        //border-top: 1px solid whiteAlp50
        
    body header.fixed
        //min-height: navHeightL
        position: fixed
        z-index: 2000
        bottom: 0

    body header.sticky
        min-height: navHeight
        position: fixed
        z-index: 6000
        padding: padXXS*0.8 0
        //display: none
        background-color: brand1
        top:0
        
    body header.stickyStatic
        min-height: navHeight
        position: fixed
        z-index: 5000
        padding: padXXS*0.8 0
        background-color: brand2
    body header > *
        /* margin-left: marStd*1.5
        margin-right: marStd*1.5*/
    body header.fixed nav.navTrigger
        display: flex
        width:100%
        column-gap: 2.5em
    body header.fixed nav.navTrigger > *
        flex: 1 1 12.5%
        text-decoration: none

    body header.fixed nav.navTrigger > *:last-child
        text-align: right
        text-decoration: underline
        border-bottom: none !important
        font-weight: 400


body header.d
    align-items: center
    

body header.d > *
    flex: 1 1 1px;  

body header.d > *:first-child
